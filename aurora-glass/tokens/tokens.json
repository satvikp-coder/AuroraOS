{
  "name": "Aurora Glass",
  "version": "1.2",
  "source": "DESIGN.md (AuroraOS, 2026-11-07)",
  "description": "Windows-inspired workspace/taskbar productivity + iOS-inspired soft glass surfaces.",
  "tiers": [
    { "id": "clear", "label": "Clear (Tier 0)", "blur": false, "opaque": true, "note": "Fully opaque panels, no alpha/blur. Default for native QEMU compositor." },
    { "id": "soft", "label": "Soft Glass (Tier 1)", "blur": true, "opaque": false, "note": "Translucent over static pre-blurred wallpaper. No live backdrop blur." },
    { "id": "dynamic", "label": "Dynamic Glass (Tier 2)", "blur": true, "opaque": false, "note": "Optional live backdrop blur on verified devices; never required." }
  ],
  "modes": ["light", "dark"],
  "tokens": {
    "canvas": { "light": "#EEF3F8", "dark": "#0B1020", "role": "Background and wallpaper base" },
    "surface-opaque": { "light": "#FFFFFF", "dark": "#192338", "role": "Critical, content-heavy, secure prompts" },
    "surface-glass": { "light": "rgba(255,255,255,0.74)", "dark": "rgba(24,32,49,0.76)", "role": "Noncritical chrome only" },
    "dock-glass": { "light": "rgba(240,246,255,0.80)", "dark": "rgba(18,27,43,0.82)", "role": "Primary bottom navigation" },
    "ink": { "light": "#142136", "dark": "#F3F7FF", "role": "Primary text" },
    "ink-muted": { "light": "#52627A", "dark": "#B4C2D8", "role": "Secondary text" },
    "accent": { "light": "#3478F6", "dark": "#6AA3FF", "role": "Selection, primary interaction" },
    "aura": { "light": "#00AEB8", "dark": "#46D6DF", "role": "Assistant/action progress" },
    "focus": { "light": "#175CD3", "dark": "#A8D7FF", "role": "Keyboard focus" }
  },
  "typography": {
    "font": "freely licensed clean sans with multilingual fallbacks (Inter/system-ui/Noto Sans CJK)",
    "routine": "14–17 px",
    "headline": "28–34 px",
    "reflow": "200%"
  },
  "geometry": {
    "radius": { "window": "16–24 px", "control": "12–18 px" },
    "touchTarget": "48 × 48 logical px",
    "spacing": [4, 8, 12, 16, 24, 32]
  },
  "motion": {
    "duration": "120–220 ms one-shot transitions",
    "reducedMotion": "respected",
    "continuousAnimation": "none"
  },
  "breakpoints": {
    "phone": "360 / 390 / 412 logical px",
    "tablet": "2-column workspace",
    "desktop": "taskbar-style Dock + snapping"
  },
  "accessibility": [
    "Keyboard navigation with visible focus",
    "Semantic labels and ARIA",
    "Screen-reader live region",
    "200% text reflow",
    "High contrast mode",
    "Reduced motion",
    "Minimum 48×48 touch targets",
    "8px minimum spacing between critical actions"
  ],
  "auraRiskLevels": {
    "S0": { "label": "Open/view/timer", "approval": "single safe step may run immediately; log result" },
    "S1": { "label": "Reversible settings", "approval": "preview if in a plan; supported undo" },
    "S2": { "label": "Edit/rename/move files", "approval": "show affected objects/diff; require tap" },
    "S3": { "label": "Delete/send/install/share", "approval": "tactile hold confirmation; never voice-only" }
  }
}
